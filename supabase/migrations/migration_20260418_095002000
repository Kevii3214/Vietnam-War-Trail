
CREATE TABLE game_settings (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  key TEXT NOT NULL UNIQUE,
  value INTEGER NOT NULL,
  label TEXT NOT NULL,
  created_at TIMESTAMPTZ DEFAULT now()
);
ALTER TABLE game_settings ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Anyone can read settings" ON game_settings FOR SELECT USING (true);
CREATE POLICY "Admins can update settings" ON game_settings FOR UPDATE TO authenticated USING (
  public.is_admin(auth.uid())
);
CREATE POLICY "Admins can insert settings" ON game_settings FOR INSERT TO authenticated WITH CHECK (
  public.is_admin(auth.uid())
);

